# hyper caps_lock

hints on

device 6:1 keyboard+pointing enabled # main keyboard
device 7:1 swaps right_command right_option # keep the right-side swap
device 3:1 swaps right_command right_option # keep the right-side swap
device 5:1 keyboard+pointing enabled # macro pad receiver
device 1:1 enabled # presenter keyboard interface
device 4:1 ignored # remote receiver handled by another tool

# $ tap sends backspace

# # hyper base
# $:
#   hjkl sends arrows +shift
#   d sends page_down
#   f sends page_up
#   a sends down_arrow
#   s sends up_arrow
#   u sends home
#   i sends end
#   y sends page_up
#   o sends page_down
#   w sends option+backspace
#   e sends option+delete_forward
#   r sends delete_forward
#   return sends option+delete_forward
#   backspace sends option+backspace

#   arrows sends ctrl+option+cmd+arrows

basic page_up:
  sends left_control
  sends left_control

# Run a command through an explicit shell.
ctrl+option+cmd+p runs /opt/homebrew/bin/fish -lc greet

# App switching with cmd+shift+key
cmd+shift+0 runs /usr/local/bin/browser
cmd+shift+hyphen opens Terminal
cmd+shift+equal opens TextEdit
cmd+shift+open_bracket opens Calendar
cmd+shift+close_bracket opens Messages
cmd+shift+1 opens Finder
cmd+shift+2 opens Home
cmd+shift+6 opens System Settings
cmd+option+shift+7 opens Photos
cmd+shift+7 opens Example App (Beta)
option+shift+7 opens Safari
cmd+shift+8 opens Music
cmd+shift+9 opens Maps
cmd+shift+\ opens Notes

# Line-editing shortcuts
ctrl+u sends cmd+backspace
ctrl+k sends cmd+shift+right_arrow
ctrl+a sends cmd+left_arrow
ctrl+e sends cmd+right_arrow
ctrl+w sends option+backspace

# Presenter: one button opens Mail and another holds a scroll layer;
# the presenter's held-key event is muted.
when device 1:1
  basic up_arrow:
    optional any
    sends left_control
    sends left_control

  basic down_arrow:
    optional any
    sends return

  basic left_option:
    optional any
    set @presenter_scroll_layer 1 until key up 0

  basic left_option+tab:
    optional any
    sends vk_none

  when @presenter_scroll_layer is 0
    basic tab:
      opens Mail

  basic left_shift+dictation:
    optional any
    sends vk_none

# TV remote: each button sends its own F-key.
# f13 dictates; f14-f16 and f19 open apps; f20 and f21 switch tabs
# inside the generated region.
# f22 enters cursor mode: arrows move the pointer and OK clicks.
# f23 leaves cursor mode.
# The volume buttons scroll.
when device 4:1
  when @remote_cursor_mode is 1
    basic up_arrow:
      moves up 1536
    basic down_arrow:
      moves down 1536
    basic left_arrow:
      moves left 1536
    basic right_arrow:
      moves right 1536
    basic return_or_enter:
      clicks left

  basic f22:
    set @remote_cursor_mode 1

  basic f23:
    set @remote_cursor_mode 0

  basic volume_up:
    scrolls up 32

  basic volume_down:
    scrolls down 32

  basic f13:
    sends left_control
    sends left_control

  basic f14:
    opens Mail

  basic f15:
    runs /usr/local/bin/browser

  basic f16:
    opens Messages

  basic f19:
    opens Safari

# Three-key pad: hold a key to run a command until release
# when app Terminal
#   cmd+b sends cmd+option+i

when app Firefox, Terminal
  basic print_screen:
    sends cmd+shift+open_bracket
  basic pause:
    sends cmd+shift+close_bracket

when app Mail
  shift+home sends cmd+open_bracket
  shift+end sends cmd+close_bracket

page_down sends return

basic pause:
  sends left_control
  sends left_control
  wait 2000ms
  sends return

shift+page_down sends cmd+return

when device 5:1
  basic a:
    optional any
    runs /usr/local/bin/lights press red
    after up runs /usr/local/bin/lights release
  basic b:
    optional any
    runs /usr/local/bin/lights press green
    after up runs /usr/local/bin/lights release
  basic c:
    optional any
    runs /usr/local/bin/lights press blue
    after up runs /usr/local/bin/lights release

# generated:start
# Generated by a companion tool. Edit it there.

when app Mail
  home sends cmd+shift+open_bracket
  end sends cmd+shift+close_bracket
  when device 2:1
    when @numpad_t9_mode is 0
      when @numpad_neru_mode is 0
        when @numpad_nav_layer is 0
          basic keypad_7:
            sends cmd+shift+open_bracket
          basic keypad_8:
            sends cmd+shift+open_bracket
          basic keypad_4:
            sends cmd+shift+open_bracket
          basic keypad_9:
            sends cmd+shift+close_bracket
          basic keypad_6:
            sends cmd+shift+close_bracket
          basic keypad_2:
            sends cmd+shift+close_bracket
  when device 1:1
    when @presenter_scroll_layer is 0
      basic volume_up:
        sends cmd+shift+open_bracket
      basic volume_down:
        sends cmd+shift+close_bracket
  when device 1:1
    when @presenter_scroll_layer is 1
      basic volume_up:
        scrolls down 32
      basic volume_down:
        scrolls up 32
  when device 4:1
    basic f20:
      sends cmd+shift+open_bracket
    basic f21:
      sends cmd+shift+close_bracket

when app Safari
  home sends ctrl+shift+tab
  end sends ctrl+tab
  when device 2:1
    when @numpad_t9_mode is 0
      when @numpad_neru_mode is 0
        when @numpad_nav_layer is 0
          basic keypad_7:
            sends ctrl+shift+tab
          basic keypad_8:
            sends ctrl+shift+tab
          basic keypad_4:
            sends ctrl+shift+tab
          basic keypad_9:
            sends ctrl+tab
          basic keypad_6:
            sends ctrl+tab
          basic keypad_2:
            sends ctrl+tab
  when device 1:1
    when @presenter_scroll_layer is 0
      basic volume_up:
        sends ctrl+shift+tab
      basic volume_down:
        sends ctrl+tab
  when device 1:1
    when @presenter_scroll_layer is 1
      basic volume_up:
        scrolls down 32
      basic volume_down:
        scrolls up 32
  when device 4:1
    basic f20:
      sends ctrl+shift+tab
    basic f21:
      sends ctrl+tab

# generated:end

# numpad generator:start
devices:
  side_numpad:
    id 2:1
    kind keyboard+pointing
    enabled

    keys:
      app_1 = keypad_num_lock
      app_2 = keypad_slash
      app_3 = keypad_asterisk
      app_4 = delete_or_backspace
      scope_prev = keypad_7
      up = keypad_8
      scope_next = keypad_9
      new = keypad_hyphen
      prev = keypad_4
      focus = keypad_5
      next = keypad_6
      send = keypad_plus
      close = keypad_1
      down = keypad_2
      descend = keypad_3
      dictate = keypad_0
      layer = keypad_period
      enter = keypad_enter

    rows:
      apps = app_1 app_2 app_3 app_4
      scope = scope_prev up scope_next new
      home = prev focus next send
      lower = close down descend
      thumb = dictate layer enter
      grid = scope_prev up scope_next prev focus next close down descend

numpad side_numpad:
  hud on

  base:
    default:
      app_1 opens Photos
      cmd+shift+7 opens Example App (Beta)
      app_2 runs /usr/local/bin/browser
      app_3 opens Messages
      app_4 opens Safari
      scope_prev sends cmd+shift+open_bracket
      up sends up_arrow
      scope_next sends cmd+shift+close_bracket
      new:
        scrolls up 32
      prev sends cmd+open_bracket
      focus sends cmd+l
      next sends cmd+close_bracket
      send:
        scrolls down 32
      close sends cmd+w
      down sends down_arrow
      descend sends return
      dictate:
        sends left_control
        sends left_control
      enter sends return

    when app Terminal:
      scope_prev sends cmd+shift+open_bracket
      scope_next sends cmd+shift+close_bracket
      prev sends cmd+shift+open_bracket
      focus sends cmd+l
      next sends cmd+shift+close_bracket
      close sends cmd+w

    when app Notes:
      scope_prev sends cmd+shift+open_bracket
      scope_next sends cmd+shift+close_bracket
      prev sends cmd+open_bracket
      next sends cmd+close_bracket
      close sends cmd+w

  layer + nav:
    app_1 enters t9
    app_2 enters neru left_click
    app_3 enters neru right_click

    default:
      app_4 opens Notes
      scope_prev sends option+up_arrow
      up sends up_arrow
      scope_next sends option+down_arrow
      new:
        scrolls up 32
      prev sends cmd+open_bracket
      focus sends cmd+f
      next sends cmd+close_bracket
      send:
        scrolls down 32
      close sends cmd+up_arrow
      down sends down_arrow
      descend sends cmd+down_arrow
      dictate:
        sends left_control
        sends left_control
        wait 2000ms
        sends return
      enter sends return

    when app Mail:
      scope_prev:
        sends up_arrow
        tracks pointer
      focus right-clicks current
      close:
        sends down_arrow
        tracks pointer

    when app Terminal:
      prev sends cmd+left_arrow
      next sends cmd+right_arrow

  mode t9:
    app_1 exits
    app_2 clears
    app_3 commits
    app_4 backtracks
    scope_prev types t9 7
    up types t9 8
    scope_next types t9 9
    new types t9 -
    prev types t9 4
    focus types t9 5
    next types t9 6
    send types t9 +
    close types t9 1
    down types t9 2
    descend types t9 3
    dictate types t9 0
    layer types t9 1
    enter commits return

  mode neru:
    app_1 exits
    app_2 clicks left then exits
    app_3 clicks right then exits
    app_4 backtracks
    new backtracks
    send selects center
    dictate resets
    layer backtracks
    enter clicks left then exits
    keys grid pass through
# numpad generator:end

# Every external keyboard, including ones connected later.
# Swap the left modifiers on all of them except the main keyboard.
when device external_keyboard
  when device_except 6:1 # already sends Command beside the spacebar
    basic left_option:
      optional any
      sends left_command

    basic left_command:
      optional any
      sends left_option
